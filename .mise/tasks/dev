#!/usr/bin/env bash
# mise description="Start Postgres, backend and frontend in development mode"

set -euo pipefail

cleanup() {
  jobs -p | xargs -r kill 2>/dev/null || true
}
trap cleanup EXIT INT TERM

mise run db:up

mise run backend &
BACKEND_PID=$!

mise run frontend &
FRONTEND_PID=$!

wait "$BACKEND_PID" "$FRONTEND_PID"
